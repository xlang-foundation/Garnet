# Optional native Apple plugin, alongside Metal. No Python inference dependency.
if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "15.0")
    message(FATAL_ERROR "Stateful Core ML plugin requires macOS15+ deployment")
endif()
if(NOT CMAKE_OSX_DEPLOYMENT_TARGET)
    set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
endif()
find_library(GARNET_COREML_FRAMEWORK CoreML REQUIRED)
add_library(garnet_coreml STATIC src/backends/coreml/coreml_session.mm)
set_target_properties(garnet_coreml PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_options(garnet_coreml PRIVATE -fobjc-arc -fblocks)
target_include_directories(garnet_coreml PUBLIC src/backends/coreml PRIVATE third_party)
target_link_libraries(garnet_coreml PUBLIC "${GARNET_COREML_FRAMEWORK}" "${GARNET_FOUNDATION_FRAMEWORK}")
add_executable(garnet_coreml_state_runtime_test test2026/coreml/state_runtime_test.cpp)
target_include_directories(garnet_coreml_state_runtime_test PRIVATE third_party)
target_link_libraries(garnet_coreml_state_runtime_test PRIVATE garnet_coreml)
set(GARNET_COREML_STATE_TEST_MODEL "" CACHE PATH "Offline compiled Core ML state fixture for native tests")
if(GARNET_COREML_STATE_TEST_MODEL)
    add_test(NAME coreml_native_state_reference COMMAND garnet_coreml_state_runtime_test "${GARNET_COREML_STATE_TEST_MODEL}")
endif()
