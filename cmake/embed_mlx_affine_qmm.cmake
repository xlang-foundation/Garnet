# Embeds MLX's affine quantized GEMM headers plus Garnet's FP32-activation entry
# point (src/backends/metal/mlx_affine_qmm_kernel.metal) as a C++ string.
# Usage: cmake -DMLX_SOURCE_DIR=<mlx> -DKERNEL=<kernel.metal> -DOUTPUT=<file.cpp> -P embed_mlx_affine_qmm.cmake
cmake_minimum_required(VERSION 3.20)
if(NOT MLX_SOURCE_DIR OR NOT KERNEL OR NOT OUTPUT)
    message(FATAL_ERROR "MLX_SOURCE_DIR, KERNEL and OUTPUT are required")
endif()
get_filename_component(MLX_SOURCE_DIR "${MLX_SOURCE_DIR}" ABSOLUTE)
set(qmm_root "${MLX_SOURCE_DIR}/mlx/backend/metal/kernels/quantized.metal")
set(qmm_marker "///////////////////////////////////////////////////////////////////////////////")
set_property(GLOBAL PROPERTY garnet_steel_seen "")

function(garnet_resolve_include current name out)
    get_filename_component(current_dir "${current}" DIRECTORY)
    foreach(candidate "${current_dir}/${name}" "${MLX_SOURCE_DIR}/${name}"
            "${MLX_SOURCE_DIR}/mlx/backend/metal/kernels/${name}")
        if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
            get_filename_component(candidate "${candidate}" REALPATH)
            set(${out} "${candidate}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Cannot resolve \"${name}\" from ${current}")
endfunction()

function(garnet_expand path text out)
    get_filename_component(path "${path}" REALPATH)
    get_property(seen GLOBAL PROPERTY garnet_steel_seen)
    if(path IN_LIST seen)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY garnet_steel_seen "${path}")
    string(REPLACE "\\" "@GARNET_BS@" text "${text}")
    string(REPLACE "[" "@GARNET_LB@" text "${text}")
    string(REPLACE "]" "@GARNET_RB@" text "${text}")
    string(REPLACE ";" "@GARNET_SC@" text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(result "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]*#[ \t]*include[ \t]+\"([^\"]+)\"[ \t]*$")
            garnet_resolve_include("${path}" "${CMAKE_MATCH_1}" included)
            file(READ "${included}" included_text)
            garnet_expand("${included}" "${included_text}" expanded)
            string(APPEND result "${expanded}\n")
        elseif(NOT line MATCHES "^[ \t]*#[ \t]*pragma[ \t]+once[ \t]*$")
            string(APPEND result "${line}\n")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

file(READ "${qmm_root}" qmm_text)
string(FIND "${qmm_text}" "${qmm_marker}" marker_at)
if(marker_at LESS 0)
    message(FATAL_ERROR "Unexpected MLX quantized kernel layout in ${qmm_root}")
endif()
string(SUBSTRING "${qmm_text}" 0 ${marker_at} qmm_declarations)
file(READ "${KERNEL}" kernel_text)
garnet_expand("${qmm_root}" "${qmm_declarations}\n${kernel_text}\n" qmm_source)
string(REPLACE "@GARNET_SC@" ";" qmm_source "${qmm_source}")
string(REPLACE "@GARNET_RB@" "]" qmm_source "${qmm_source}")
string(REPLACE "@GARNET_LB@" "[" qmm_source "${qmm_source}")
string(REPLACE "@GARNET_BS@" "\\" qmm_source "${qmm_source}")
string(FIND "${qmm_source}" ")GARNET_MLX_QMM\"" delimiter_at)
if(NOT delimiter_at EQUAL -1)
    message(FATAL_ERROR "MLX quantized source contains the raw-string delimiter")
endif()
file(WRITE "${OUTPUT}.tmp"
    "#include \"mlx_affine_qmm_source.h\"\n"
    "namespace Garnet {\n"
    "const char* MLXAffineQmmSource() {\n"
    "return R\"GARNET_MLX_QMM(\n${qmm_source})GARNET_MLX_QMM\";\n"
    "}\n"
    "}\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
