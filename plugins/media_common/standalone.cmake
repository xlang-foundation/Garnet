set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
if(MSVC)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    add_compile_definitions(NOMINMAX WIN32_LEAN_AND_MEAN)
endif()
get_filename_component(GARNET_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include_directories("${GARNET_SOURCE}/src/media" "${GARNET_SOURCE}/third_party" "${GARNET_SOURCE}/plugins/media_common")
set(GARNET_MEDIA_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/plugins/media" CACHE PATH "Native media DLL destination")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${GARNET_MEDIA_OUTPUT_DIRECTORY}")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${GARNET_MEDIA_OUTPUT_DIRECTORY}")
