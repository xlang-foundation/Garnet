+        std::array<MetalMatrix,2> scratch{Allocate(14336,2048),Allocate(8192,7168)};
+        impl_->diagnosticBulkScratch=std::move(scratch);impl_->diagnosticBulkUnpack=unpack;impl_->diagnosticBulkCast=cast;
