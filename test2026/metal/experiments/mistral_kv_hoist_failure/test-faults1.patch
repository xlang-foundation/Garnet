+#ifdef GARNET_METAL_KV_HOIST_TEST_FAULTS
+void MetalContext::ArmKVHoistTestFault(unsigned mode){
+    if(mode>2)throw std::invalid_argument("KV hoist test fault mode must be0,1,2");
+    if(impl_->command||impl_->submitted.count)throw std::logic_error("Arm KV hoist faults between drained command batches");
+    impl_->kvHoistFaultArmed=mode;impl_->kvHoistFaultLast=0;
+    impl_->kvHoistFaultEncoded=impl_->kvHoistFaultSubmitted=impl_->kvHoistFaultDrained=impl_->kvHoistFaultCompleted=0;
+    impl_->kvHoistFaultAborted=false;impl_->kvHoistFaultGpuMs=0;
+}
+void MetalContext::DisarmKVHoistTestFault(){impl_->kvHoistFaultArmed=0;}
+void MetalContext::MaybeFailAfterKVHoist(){
+    const auto mode=impl_->kvHoistFaultArmed;if(!mode)return;
+    impl_->kvHoistFaultArmed=0;impl_->kvHoistFaultLast=mode;impl_->kvHoistFaultEncoded=impl_->chunkKVHoistedCommits;
+    if(mode==2)Flush();
+    impl_->kvHoistFaultSubmitted=impl_->submitted.count;
+    throw std::runtime_error(mode==1?"Injected KV hoist fault before submission":"Injected KV hoist fault after partial submission");
+}
+std::string MetalContext::KVHoistTestFaultWitnessJson() const{
+    std::ostringstream out;out<<"{\"armed\":"<<impl_->kvHoistFaultArmed<<",\"mode\":"<<impl_->kvHoistFaultLast
