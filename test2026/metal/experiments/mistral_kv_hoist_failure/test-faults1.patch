+        <<",\"drained_commands\":"<<impl_->kvHoistFaultDrained<<",\"completed_commands\":"<<impl_->kvHoistFaultCompleted
+        <<",\"native_abort_called\":"<<(impl_->kvHoistFaultAborted?"true":"false")<<",\"observed_gpu_ms\":"<<impl_->kvHoistFaultGpuMs
+        <<",\"pending_outputs\":"<<impl_->pendingOutputs.size()<<",\"live_command\":"<<(impl_->command?"true":"false")
+        <<",\"live_submissions\":"<<impl_->submitted.count<<"}";return out.str();
+}
