diff --git a/src/backends/metal/chunk_mps_contiguous_policy.h b/src/backends/metal/chunk_mps_contiguous_policy.h
new file mode 100644
--- /dev/null
+++ b/src/backends/metal/chunk_mps_contiguous_policy.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cmath>
+#include <cstddef>
+namespace Garnet {
+// Call only for completed, shared, nonpending controls. Unknown GPU controls
+// must retain generic selection; this helper never synchronizes or reads them.
+inline bool ChunkMPSContiguousPrefix(size_t batch,size_t chunk,size_t capacity,
+    const float* slots,size_t slotStride,const float* active,size_t activeStride) {
+    if(!batch||batch>4||!chunk||chunk>512||!capacity||capacity>4096||
+       !slots||!active||slotStride<chunk||activeStride<chunk)return false;
+    for(size_t b=0;b<batch;++b) {
+        size_t count=0;
+        while(count<chunk&&active[b*activeStride+count]!=0) {
+            if(!std::isfinite(active[b*activeStride+count]))return false;
+            ++count;
+        }
+        for(size_t t=count;t<chunk;++t)if(active[b*activeStride+t]!=0)return false;
+        if(!count)continue;
+        float first=slots[b*slotStride];
+        if(count>capacity||!std::isfinite(first)||first<0||first!=std::floor(first)||
+           double(first)+double(count)>double(capacity))return false;
+        for(size_t t=0;t<count;++t)
+            if(slots[b*slotStride+t]!=first+float(t))return false;
+    }
+    return true;
+}
+}
diff --git a/src/backends/metal/chunk_mps_contiguous_shader.h b/src/backends/metal/chunk_mps_contiguous_shader.h
new file mode 100644
--- /dev/null
+++ b/src/backends/metal/chunk_mps_contiguous_shader.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+namespace Garnet {
+inline constexpr const char* kChunkMPSContiguousShader=R"METAL(
+#if defined(GARNET_CHUNK_ATTENTION_INDEX32) && defined(GARNET_CHUNK_ATTENTION_BUCKETS)
+kernel void chunk_mps_softmax_contiguous(device float* cacheScores [[buffer(0)]],device const float* liveScores [[buffer(1)]],
+    device float* liveProb [[buffer(2)]],device const float* slots [[buffer(3)]],device const float* active [[buffer(4)]],
+    constant ChunkAttentionParams& runtime [[buffer(5)]],constant ChunkMPSPitch& pitch [[buffer(6)]],
+    threadgroup float* scratch [[threadgroup(0)]],
+    uint query [[threadgroup_position_in_grid]],uint tid [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],uint simd [[simdgroup_index_in_threadgroup]]) {
+    const auto p=chunk_mps_params(runtime);
+    uint t=query%p.chunk,b=query/(p.chunk*p.heads);
+#ifdef GARNET_CHUNK_ATTENTION_BUCKETS
+    const uint extent=chunk_mps_extent;
+#else
+    const uint extent=p.capacity;
+#endif
+    if(active[b*p.aStride+t]==0) {
+        for(uint s=tid;s<extent;s+=128)cacheScores[query*pitch.cacheScore+s]=0;
+        for(uint j=tid;j<p.chunk;j+=128)liveProb[query*pitch.liveScore+j]=0;
+        return;
+    }
+    uint visible=uint(min(ulong(extent),ulong(slots[b*p.sStride+t])+1));
+    // Admitted only after completed native controls prove contiguous active prefixes.
+    const int first=int(slots[b*p.sStride]);
+    threadgroup float partial[4];
+    for(uint s=tid;s<visible;s+=128) {
+        int latest=-1;
+        int candidate=int(s)-first;if(candidate>=0&&candidate<=int(t))latest=candidate;
+        scratch[s]=(latest<0?cacheScores[query*pitch.cacheScore+s]:liveScores[query*pitch.liveScore+uint(latest)])*rsqrt(float(p.dim));
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float maximum=-INFINITY;for(uint s=tid;s<visible;s+=128)maximum=max(maximum,scratch[s]);
+    maximum=simd_max(maximum);if(lane==0)partial[simd]=maximum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    maximum=simd_max(lane<4?partial[lane]:-INFINITY);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float denominator=0;
+    for(uint s=tid;s<visible;s+=128){float probability=exp(scratch[s]-maximum);scratch[s]=probability;denominator+=probability;}
+    denominator=simd_sum(denominator);if(lane==0)partial[simd]=denominator;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    denominator=simd_sum(lane<4?partial[lane]:0.0f);
+    // All scratch reads below follow the last writes before the reduction's
+    // threadgroup barrier. Each output probability has one owning thread.
+    for(uint s=tid;s<extent;s+=128)
+        cacheScores[query*pitch.cacheScore+s]=s<visible&&(int(s)<first||int(s)>first+int(t))?scratch[s]/denominator:0;
+    for(uint j=tid;j<p.chunk;j+=128) {
+        float position=slots[b*p.sStride+j];
+        bool valid=j<=t&&active[b*p.aStride+j]!=0&&isfinite(position)&&position>=0&&position<float(visible)&&position==floor(position);
+        liveProb[query*pitch.liveScore+j]=valid?scratch[uint(position)]/denominator:0;
+    }
+}
+#endif
+)METAL";
+}
diff --git a/test2026/metal/contiguous_softmax_policy_test.cpp b/test2026/metal/contiguous_softmax_policy_test.cpp
new file mode 100644
--- /dev/null
+++ b/test2026/metal/contiguous_softmax_policy_test.cpp
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "../../src/backends/metal/chunk_mps_contiguous_policy.h"
+#include <array>
+#include <limits>
+#include <stdexcept>
+#include <iostream>
+using namespace Garnet;
+int main(){try{
+    constexpr size_t batch=4,chunk=17,stride=21;
+    std::array<float,batch*stride> slots{},active{};
+    for(size_t b=0;b<batch;++b)for(size_t t=0;t<chunk;++t){slots[b*stride+t]=float(128+t);active[b*stride+t]=float(t<chunk-b);}
+    auto need=[](bool yes){if(!yes)throw std::runtime_error("Contiguous prefix proof differs");};
+    auto admit=[&]{return ChunkMPSContiguousPrefix(batch,chunk,256,slots.data(),stride,active.data(),stride);};
+    need(admit());size_t rejected=0;
+    auto originalSlots=slots,originalActive=active;
+    for(float bad:{-1.0f,0.5f,std::numeric_limits<float>::infinity(),std::numeric_limits<float>::quiet_NaN(),250.0f}) {
+        slots=originalSlots;slots[0]=bad;need(!admit());++rejected;
+    }
+    slots=originalSlots;slots[5]=slots[4];need(!admit());++rejected;
+    slots=originalSlots;active[4]=0;need(!admit());++rejected;
+    active=originalActive;active[0]=std::numeric_limits<float>::quiet_NaN();need(!admit());++rejected;
+    active=originalActive;active[chunk-1]=0;need(admit());
+    active.fill(0);slots.fill(std::numeric_limits<float>::quiet_NaN());need(admit());
+    need(!ChunkMPSContiguousPrefix(5,chunk,256,slots.data(),stride,active.data(),stride));
+    need(!ChunkMPSContiguousPrefix(batch,chunk,8192,slots.data(),stride,active.data(),stride));
+    need(!ChunkMPSContiguousPrefix(batch,chunk,256,nullptr,stride,active.data(),stride));
+    need(!ChunkMPSContiguousPrefix(batch,chunk,256,slots.data(),chunk-1,active.data(),stride));
+    need(!ChunkMPSContiguousPrefix(batch,0,256,slots.data(),stride,active.data(),stride));
+    std::cout<<"Native contiguous-control proof: strided/ragged/empty valid controls; "<<rejected<<" changed invalid controls and5 unsupported layouts rejected\n";return 0;
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
