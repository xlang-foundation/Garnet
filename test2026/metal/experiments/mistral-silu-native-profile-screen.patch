+int main(int argc,char** argv){try{Need(argc==4,"EDGE FINITE NEW_DIRECTORY required");std::filesystem::path out=argv[3];Need(std::filesystem::create_directory(out),"Fresh output required");JSON report={{"scope","Actual native in-context same-library SiLU32 screen; optional local C++ diagnostic, no model/serving admission"},{"parent","f61fb838437449095a1284fb81564f382dbb355b"},{"warmups",3},{"repetitions",9},{"cases",JSON::array()}};size_t index=0,words=0;
+for(size_t corpus=0;corpus<2;++corpus){std::filesystem::path src=argv[1+corpus];std::ifstream lines(src/"operator1.jsonl");std::string line;
+while(std::getline(lines,line)){auto entry=JSON::parse(line);if(entry["kind"]!="writer_check")continue;size_t cell=entry["index"],rows=entry["rows"],cols=entry["columns"],stride=entry["stride"];auto a=Read(src/"operator1"/("case-"+std::to_string(cell)+"-a.f32"),rows*stride),b=Read(src/"operator1"/("case-"+std::to_string(cell)+"-b.f32"),rows*stride);std::vector<float> la(rows*cols),lb(rows*cols);for(size_t row=0;row<rows;++row){std::copy_n(a.data()+row*stride,cols,la.data()+row*cols);std::copy_n(b.data()+row*stride,cols,lb.data()+row*cols);}
+JSON record={{"corpus",corpus?"finite":"edge"},{"source",src.string()},{"source_case",cell},{"rows",rows},{"columns",cols},{"source_stride",stride},{"gpu_ms",JSON::array()}};
+{MetalContext gpu;auto ma=gpu.Upload(la,rows,cols),mb=gpu.Upload(lb,rows,cols),mc=gpu.Allocate(rows,cols);auto owners=MetalContext::ProfileOwnerStats();std::array<std::vector<double>,2> times;std::array<std::vector<float>,2> first;
+for(int rep=-3;rep<9;++rep)for(size_t order=0;order<2;++order){size_t enabled=(order+size_t(rep+3))%2;gpu.SetDiagnosticSilu32(enabled);gpu.Begin();gpu.EncodeSiluMul(ma,mb,mc);gpu.SubmitAndWait();bool eligible=(cols==14336||cols==4096);Need(gpu.LastDiagnosticSilu32Dispatches()==size_t(enabled&&eligible),"Wrong in-context route");auto values=gpu.Download(mc);if(first[enabled].empty())first[enabled]=values;else Need(!std::memcmp(first[enabled].data(),values.data(),values.size()*4),"Unstable native output");if(rep>=0)times[enabled].push_back(gpu.LastGPUMs());words+=values.size();}
+Need(!std::memcmp(first[0].data(),first[1].data(),first[0].size()*4),"Native SiLU32 bits differ");auto original=Read(src/"operator1"/("case-"+std::to_string(cell)+"-actual-native.f32"),rows*cols);Need(!std::memcmp(first[0].data(),original.data(),original.size()*4),"Original native values differ");Save(out/("case-"+std::to_string(index)+"-off.f32"),first[0]);Save(out/("case-"+std::to_string(index)+"-on.f32"),first[1]);record["gpu_ms"]={times[0],times[1]};record["eligible"]=(cols==14336||cols==4096);record["bits_equal"]=true;record["actual_original_bits_equal"]=true;auto after=MetalContext::ProfileOwnerStats();Need(after.matrices==owners.matrices&&after.pipelineSets==owners.pipelineSets,"Request-time allocation");}
+report["cases"].push_back(record);std::cout<<"native_silu "<<index++<<" PASS\n"<<std::flush;
+}}
+auto owners=MetalContext::ProfileOwnerStats();Need(!owners.matrices&&!owners.pipelineSets&&!owners.affineWeights,"Retained owners");report["passed"]=true;report["checked_runtime_words"]=words;Need(index==20,"Missing cases");std::ofstream f(out/"results.json");f<<report.dump(2)<<'\n';Need(bool(f),"Save report");return 0;}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
