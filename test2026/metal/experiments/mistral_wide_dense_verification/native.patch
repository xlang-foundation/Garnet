+ {MetalContext gpu;for(auto shape:std::vector<std::pair<size_t,size_t>>{{17,64},{33,128},{1024,4096},{4096,4096},{14336,4096},{4096,14336},{32768,4096}})Case(gpu,shape.first,shape.second);}
