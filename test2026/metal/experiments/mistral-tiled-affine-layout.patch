index 0000000000000000000000000000000000000000..854e42ef460d239f47673d8855d0d00f3bb26779
--- /dev/null
+++ b/test2026/metal/affine_tiled_layout_test.cpp
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "../../src/backends/metal/affine_tiled_weight_layout.h"
+#include <vector>
+#include <array>
+#include <iostream>
+#include <limits>
+using Garnet::AffineTiledWeightLayout;
+namespace {
+size_t cases=0,bytes=0,rejections=0;
+void Need(bool v){if(!v)throw std::runtime_error("Tiled affine host oracle mismatch");}
+template<class F>void Reject(F f){bool bad=false;try{f();}catch(const std::exception&){bad=true;}Need(bad);++rejections;}
+void Case(size_t n,size_t k){
+ auto layout=AffineTiledWeightLayout::Create(n,k);const size_t padded=(n+63)/64*64;
+ Need(layout.PaddedRows()==padded&&layout.WeightBytes()==padded*k/2&&layout.CoefficientBytes()==padded*k/32);
+ std::array<std::vector<unsigned char>,3> input,output;
+ const size_t sourceBytes[3]{n*k/2,n*k/32,n*k/32},destBytes[3]{padded*k/2,padded*k/32,padded*k/32};
+ for(size_t part=0;part<3;++part){input[part].resize(sourceBytes[part]+1);for(size_t i=0;i<sourceBytes[part];++i)input[part][i+1]=static_cast<unsigned char>(i*137+part*43+11);output[part].assign(destBytes[part]+2,0xcd);}
+ layout.Pack({input[0].data()+1,sourceBytes[0]},{input[1].data()+1,sourceBytes[1]},{input[2].data()+1,sourceBytes[2]},
+  {output[0].data()+1,destBytes[0]},{output[1].data()+1,destBytes[1]},{output[2].data()+1,destBytes[2]});
+ // Independently decode destination tile coordinates; do not call address helpers.
+ for(size_t part=0;part<3;++part){
+  Need(output[part].front()==0xcd&&output[part].back()==0xcd);
+  const size_t blockBytes=part?128:2048,rowBytes=part?2:32;
+  for(size_t pos=0;pos<destBytes[part];++pos){const size_t tile=pos/blockBytes,within=pos%blockBytes,row=(tile/(k/64))*64+within/rowBytes,group=tile%(k/64),element=within%rowBytes;const auto expected=row<n?input[part][1+row*(part?k/32:k/2)+group*rowBytes+element]:0;Need(output[part][pos+1]==expected);++bytes;}
+ }
+ Need(layout.Index32Fits());++cases;
+}
+void Guards(){
+ for(auto dims:std::array<std::array<size_t,2>,6>{{{0,64},{1,0},{1,63},{1,96},{SIZE_MAX,64},{SIZE_MAX/64,128}}})Reject([&]{AffineTiledWeightLayout::Create(dims[0],dims[1]);});
+ auto layout=AffineTiledWeightLayout::Create(1,64);Reject([&]{layout.WordIndex(64,0);});Reject([&]{layout.WordIndex(0,8);});Reject([&]{layout.CoefficientIndex(64,0);});Reject([&]{layout.CoefficientIndex(0,1);});
+ std::vector<unsigned char> w(32,1),s(2,2),b(2,3),ow(2048,0xcd),os(128,0xcd),ob(128,0xcd);auto original=ow;
+ auto pack=[&](AffineTiledWeightLayout::Source wi,AffineTiledWeightLayout::Source si,AffineTiledWeightLayout::Source bi,AffineTiledWeightLayout::Destination wo,AffineTiledWeightLayout::Destination so,AffineTiledWeightLayout::Destination bo){layout.Pack(wi,si,bi,wo,so,bo);};
+ Reject([&]{pack({w.data(),31},{s.data(),2},{b.data(),2},{ow.data(),2048},{os.data(),128},{ob.data(),128});});
+ Reject([&]{pack({w.data(),32},{s.data(),2},{b.data(),2},{ow.data(),2048},{os.data(),127},{ob.data(),128});});
+ Reject([&]{pack({nullptr,32},{s.data(),2},{b.data(),2},{ow.data(),2048},{os.data(),128},{ob.data(),128});});
+ Reject([&]{pack({w.data(),32},{s.data(),2},{b.data(),2},{ow.data(),2048},{nullptr,128},{ob.data(),128});});
+ Reject([&]{pack({ow.data(),32},{s.data(),2},{b.data(),2},{ow.data(),2048},{os.data(),128},{ob.data(),128});});
+ Reject([&]{pack({w.data(),32},{s.data(),2},{b.data(),2},{ow.data(),2048},{ow.data()+32,128},{ob.data(),128});});
+ Reject([&]{pack({reinterpret_cast<const void*>(UINTPTR_MAX-1),32},{s.data(),2},{b.data(),2},{ow.data(),2048},{os.data(),128},{ob.data(),128});});
+ Need(ow==original);for(auto value:os)Need(value==0xcd);for(auto value:ob)Need(value==0xcd);
+ const auto large=AffineTiledWeightLayout::Create(65537,524288);Need(!large.Index32Fits());
+}
+}
+int main(){try{for(size_t n:{size_t(1),size_t(31),size_t(63),size_t(64),size_t(65),size_t(127),size_t(128),size_t(129)})for(size_t k:{size_t(64),size_t(128),size_t(192)})Case(n,k);Guards();std::cout<<"tiled_affine_host PASS cases="<<cases<<" bytes="<<bytes<<" rejections="<<rejections<<'\n';return 0;}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
