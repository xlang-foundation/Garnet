diff --git a/src/backends/metal/affine_int4_tiled_decode_shader.h b/src/backends/metal/affine_int4_tiled_decode_shader.h
new file mode 100644
index 0000000000000000000000000000000000000000..02a61a5434aad10331871e04046d410816f6b64c
--- /dev/null
+++ b/src/backends/metal/affine_int4_tiled_decode_shader.h
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+namespace Garnet {
+// Stage32 output channels and256 inner elements from tiled storage. Every output
+// retains the original word/lane order, FP32 dequantization/FMA and SIMD sum.
+inline constexpr const char* kAffineInt4TiledDecodeShader=R"METAL(
+struct TiledDecodeParams {ulong rows,inner,columns,aStride,oStride;};
+kernel void affine_q4_tiled_decode(device const float* a [[buffer(0)]],
+ device const uint* packed [[buffer(1)]],device const ushort* scales [[buffer(2)]],
+ device const ushort* biases [[buffer(3)]],device float* out [[buffer(4)]],
+ constant TiledDecodeParams& runtime [[buffer(5)]],
+#ifdef GARNET_TILED_INDEXED
+ constant uint* indices [[buffer(6)]],
+#endif
+ uint group [[threadgroup_position_in_grid]],uint lane [[thread_index_in_simdgroup]],
+ uint simd [[simdgroup_index_in_threadgroup]],uint tid [[thread_index_in_threadgroup]]) {
+    GARNET_AFFINE_PARAMETERS(TiledDecodeParams);
+    threadgroup uint words[32*32];
+    threadgroup ushort tileScales[32*4],tileBiases[32*4];
+    const AffineIndex first=AffineIndex(group)*32,localFirst=AffineIndex(simd)*8;
+    AffineIndex physical[4];float sums[4][8];
+    #pragma clang loop unroll(full)
+    for(uint row=0;row<4;++row) {
+#ifdef GARNET_TILED_INDEXED
+        physical[row]=row<GARNET_TILED_ROWS?indices[row]:0;
+#else
+        physical[row]=row;
+#endif
+        #pragma clang loop unroll(full)
+        for(uint column=0;column<8;++column)sums[row][column]=0.0f;
+    }
+    for(AffineIndex base=0;base<p.inner;base+=256) {
+        for(uint i=tid;i<1024;i+=128) {
+            const uint kGroup=i/256,nLocal=(i%256)/8,kWord=i%8;
+            const AffineIndex n=first+nLocal,word=base/8+kGroup*8+kWord;
+            words[nLocal*32+kGroup*8+kWord]=(n<p.columns&&word<p.inner/8)?packed[garnet_affine_word_offset(n,word,p.inner)]:0;
+        }
+        const uint kGroup=tid/32,nLocal=tid%32;
+        const AffineIndex n=first+nLocal,coefficientGroup=base/64+kGroup;
+        ushort scale=0,bias=0;
+        if(n<p.columns&&coefficientGroup<p.inner/64) {
+            const AffineIndex index=garnet_affine_coefficient_offset(n,coefficientGroup,p.inner);
+            scale=scales[index];bias=biases[index];
+        }
+        tileScales[nLocal*4+kGroup]=scale;tileBiases[nLocal*4+kGroup]=bias;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        const AffineIndex word=base/8+lane;
+        if(word<p.inner/8) {
+            float4 low[4],high[4];
+            #pragma clang loop unroll(full)
+            for(uint row=0;row<4;++row)if(row<GARNET_TILED_ROWS) {
+                const AffineIndex at=physical[row]*p.aStride+word*8;
+                low[row]=float4(*reinterpret_cast<device const packed_float4*>(a+at));
+                high[row]=float4(*reinterpret_cast<device const packed_float4*>(a+at+4));
+            }
+            #pragma clang loop unroll(full)
+            for(uint column=0;column<8;++column)if(first+localFirst+column<p.columns) {
+                const uint nLocal=uint(localFirst)+column;
+                const uint values=words[nLocal*32+lane];
+                const float scale=garnet_affine_coefficient(tileScales[nLocal*4+lane/8]);
+                const float bias=garnet_affine_coefficient(tileBiases[nLocal*4+lane/8]);
+                #pragma clang loop unroll(full)
+                for(uint j=0;j<8;++j) {
+                    const float weight=fma(float((values>>(4*j))&15u),scale,bias);
+                    #pragma clang loop unroll(full)
+                    for(uint row=0;row<4;++row)if(row<GARNET_TILED_ROWS)
+                        sums[row][column]=fma(j<4?low[row][j]:high[row][j-4],weight,sums[row][column]);
+                }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    #pragma clang loop unroll(full)
+    for(uint column=0;column<8;++column)if(first+localFirst+column<p.columns) {
+        #pragma clang loop unroll(full)
+        for(uint row=0;row<4;++row)if(row<GARNET_TILED_ROWS) {
+            const float total=simd_sum(sums[row][column]);
+            if(lane==0)out[physical[row]*p.oStride+first+localFirst+column]=total;
+        }
+    }
+}
+)METAL";
+}
diff --git a/src/backends/metal/affine_tiled_weight_layout.h b/src/backends/metal/affine_tiled_weight_layout.h
new file mode 100644
index 0000000000000000000000000000000000000000..5aacb2d48a6e7f20f7c0c6b57dba5d3a56ddbd86
--- /dev/null
+++ b/src/backends/metal/affine_tiled_weight_layout.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <array>
+namespace Garnet {
+// Native GPU representation only; checkpoint payloads retain MLX row-major order.
+class AffineTiledWeightLayout {
+    size_t rows_,inner_,padded_,weights_,coefficients_;
+    AffineTiledWeightLayout(size_t n,size_t k,size_t padded):rows_(n),inner_(k),padded_(padded),weights_(padded*(k/8)*4),coefficients_(padded*(k/64)*2){}
+public:
+    struct Source {const void* data;size_t bytes;};
+    struct Destination {void* data;size_t bytes;};
+    static AffineTiledWeightLayout Create(size_t rows,size_t inner) {
+        if(!rows||!inner||inner%64||rows>SIZE_MAX-63)throw std::invalid_argument("Tiled affine requires nonempty group64 dimensions");
+        const size_t padded=((rows+63)/64)*64;
+        if(padded>SIZE_MAX/inner)throw std::overflow_error("Tiled affine padded elements overflow");
+        return AffineTiledWeightLayout(rows,inner,padded);
+    }
+    size_t PaddedRows()const{return padded_;}
+    size_t WeightBytes()const{return weights_;}
+    size_t CoefficientBytes()const{return coefficients_;}
+    size_t WordIndex(size_t n,size_t word)const {
+        if(n>=padded_||word>=inner_/8)throw std::out_of_range("Tiled affine word index");
+        return ((n/64)*(inner_/64)+word/8)*512+(n%64)*8+word%8;
+    }
+    size_t CoefficientIndex(size_t n,size_t group)const {
+        if(n>=padded_||group>=inner_/64)throw std::out_of_range("Tiled affine coefficient index");
+        return ((n/64)*(inner_/64)+group)*64+n%64;
+    }
+    bool Index32Fits()const{return weights_/4<=UINT32_MAX&&coefficients_/2<=UINT32_MAX;}
+    void Pack(Source weights,Source scales,Source biases,Destination outWeights,Destination outScales,Destination outBiases)const {
+        const std::array<Source,3> source{weights,scales,biases};const std::array<Destination,3> dest{outWeights,outScales,outBiases};
+        const size_t sourceSizes[3]{rows_*(inner_/8)*4,rows_*(inner_/64)*2,rows_*(inner_/64)*2};
+        const size_t destSizes[3]{weights_,coefficients_,coefficients_};
+        auto end=[](const void* p,size_t bytes) {
+            const auto begin=reinterpret_cast<uintptr_t>(p);
+            if(!p||bytes>UINTPTR_MAX-begin)throw std::invalid_argument("Invalid tiled affine byte range");
+            return begin+bytes;
+        };
+        // Validate every range and overlap before the first destination write.
+        for(size_t i=0;i<3;++i){if(source[i].bytes!=sourceSizes[i]||dest[i].bytes!=destSizes[i])throw std::invalid_argument("Tiled affine payload length mismatch");end(source[i].data,source[i].bytes);end(dest[i].data,dest[i].bytes);}
+        auto overlaps=[&](const void* a,size_t an,const void* b,size_t bn){return reinterpret_cast<uintptr_t>(a)<end(b,bn)&&reinterpret_cast<uintptr_t>(b)<end(a,an);};
+        for(size_t i=0;i<3;++i){for(size_t j=0;j<3;++j)if(overlaps(dest[i].data,dest[i].bytes,source[j].data,source[j].bytes))throw std::invalid_argument("Tiled affine source/destination overlap");for(size_t j=0;j<i;++j)if(overlaps(dest[i].data,dest[i].bytes,dest[j].data,dest[j].bytes))throw std::invalid_argument("Tiled affine destination overlap");}
+        for(size_t n=0;n<padded_;++n)for(size_t group=0;group<inner_/64;++group) {
+            const size_t offsets[3]{WordIndex(n,group*8)*4,CoefficientIndex(n,group)*2,CoefficientIndex(n,group)*2};
+            const size_t lengths[3]{32,2,2};
+            const size_t from[3]{(n*(inner_/8)+group*8)*4,(n*(inner_/64)+group)*2,(n*(inner_/64)+group)*2};
+            for(size_t i=0;i<3;++i){auto out=static_cast<unsigned char*>(dest[i].data)+offsets[i];if(n<rows_)std::memcpy(out,static_cast<const unsigned char*>(source[i].data)+from[i],lengths[i]);else std::memset(out,0,lengths[i]);}
+        }
+    }
+};
