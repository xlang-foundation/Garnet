+kernel void half_policy_p16(device const half* q [[buffer(0)]],device const half* kc [[buffer(1)]],device const half* vc [[buffer(2)]],device const float* gate [[buffer(3)]],device float* output [[buffer(4)]],constant HalfChunkParams& runtime [[buffer(5)]],constant HalfChunkControls& controls [[buffer(6)]],uint3 group [[threadgroup_position_in_grid]],uint sg [[simdgroup_index_in_threadgroup]],uint lane [[thread_index_in_simdgroup]]){half_policy_attention_impl<false>(q,kc,vc,gate,output,runtime,controls,group,sg,lane);}
