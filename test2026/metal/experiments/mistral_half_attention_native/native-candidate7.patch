+kernel void half_policy_pack_q(device const float* q [[buffer(0)]],device half* packed [[buffer(1)]],constant HalfChunkParams& runtime [[buffer(2)]],constant HalfChunkControls& controls [[buffer(3)]],device atomic_uint* status [[buffer(4)]],device const float* gate [[buffer(5)]],uint n [[thread_position_in_grid]]) {
+ const auto p=half_chunk_params(runtime);uint row=n/4096,d=n%4096;if(row>=p.batch*p.chunk)return;
+ uint b=row/p.chunk,t=row%p.chunk;bool active=t<controls.count[b];float x=active?q[row*p.qStride+d]:0;
+ bool valid=isfinite(x)&&abs(x)<=2048;if(!valid)atomic_fetch_or_explicit(status,1,memory_order_relaxed);
+ if(active&&p.gated&&!isfinite(gate[row*p.gStride+d]))atomic_fetch_or_explicit(status,8,memory_order_relaxed);
+ packed[row*4096+d]=valid?half(x):half(0);
+}
