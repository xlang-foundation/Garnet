+# SPDX-License-Identifier: Apache-2.0
+"""Research only: existing residual adapters with the target quantized head.
+
+The raw adapter's training base is unverified. Target verification remains
+mandatory. No compatibility, acceptance, performance or quality is assumed.
+"""
+import json,os
+import garnet,tensor
+from xModel.qwen.metal_dense.layers import T,norm,reshape
+
+class SharedMedusaDraft:
+ def __init__(self,target,folder):
+  self.io=target.io;self.normalizer=None;self.features=[];self.project=None
+  if target.batch!=1 or 'medusa_residual_features_bf16' not in garnet.backend_info():raise ValueError('Prepared B1 residual-feature extension required')
+  with open(folder+'/config.json') as f:config=json.load(f)
+  if config.get('medusa_num_heads')!=4 or config.get('medusa_num_layers')!=1:raise ValueError('Explicit four-head one-layer artifact required')
+  if target.config['hidden_size']!=4096 or target.config['vocab_size']!=32768:raise ValueError('Mistral4096/32768 required')
+  try:
+   symbol=tensor.input('shared_medusa_norm',shape=[1,4096],dtype=tensor.float32)
+   @T.fusion(name='shared_medusa_norm',boundary='required')
+   def normalized(hidden):return norm(hidden,'model.norm',target.config)
+   self.normalizer=garnet.compiled_graph();self.normalizer.build_shared(normalized(symbol),[symbol],target.checkpoint,target.head)
+   for index in range(3):
+    symbol=tensor.input('shared_medusa_feature_'+str(index),shape=[1,4096],dtype=tensor.float32)
+    @T.fusion(name='shared_medusa_feature_'+str(index),boundary='required')
+    def residual(hidden):return hidden*T.unary_op('medusa_residual_head',head_index=index,emit_features=2)
+    graph=garnet.compiled_graph();self.features.append(graph);graph.build(residual(symbol),[symbol],folder+'/model.safetensors')
+   symbol=tensor.input('shared_medusa_vocabulary',shape=[1,4,4096],dtype=tensor.float32)
+   @T.fusion(name='shared_medusa_vocabulary',boundary='required')
+   def vocabulary(hidden):return reshape(hidden,[4,4096])*T.unary_op('qwen_text_head',weight_name='lm_head.weight',bf16_weight=1)
+   self.project=garnet.compiled_graph();self.project.build_shared(vocabulary(symbol),[symbol],target.checkpoint,target.head)
+  except:self.close();raise
+ def logits(self,hidden):
+  normalized=self.normalizer.run([hidden]);features=[graph.run([normalized]) for graph in self.features]
+  return normalized,features,self.project.run([self.io.stack_tokens([normalized]+features)])
+ def propose(self,hidden,known):
+  _,_,logits=self.logits(hidden);tokens=self.io.argmax(logits)
+  if tokens[0]!=known:raise ValueError('Target row anchor changed')
+  return tokens[1:]
+ def close(self):
+  if self.project is not None:self.project.close()
+  self.project=None
+  for graph in self.features:graph.close()
+  self.features=[]
+  if self.normalizer is not None:self.normalizer.close()
+  self.normalizer=None
