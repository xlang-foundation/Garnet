+        auto packed=[device newBufferWithLength:packedBytes options:MTLResourceStorageModeShared];
+        auto scales=[device newBufferWithLength:coefficientBytes options:MTLResourceStorageModeShared];
+        auto biases=[device newBufferWithLength:coefficientBytes options:MTLResourceStorageModeShared];
+        if(!packed||!scales||!biases)throw std::runtime_error("Cannot allocate prepared N4 weights");
+        MistralN4Pack(static_cast<const uint32_t*>(w->packed.contents),static_cast<uint32_t*>(packed.contents),w->rows,w->columns/8);
+        MistralN4Pack(static_cast<const uint16_t*>(w->scales.contents),static_cast<uint16_t*>(scales.contents),w->rows,w->columns/64);
+        MistralN4Pack(static_cast<const uint16_t*>(w->biases.contents),static_cast<uint16_t*>(biases.contents),w->rows,w->columns/64);
+        w->n4Packed=packed;w->n4Scales=scales;w->n4Biases=biases;w->n4Charge=bytes;n4Weights.fetch_add(1);
+    }catch(...){n4Bytes.fetch_sub(bytes);throw;}
+}
+}
