+    const auto gold=gpu.Download(out);
+    Need(gpu.PrepareAffineInt4Profile(x,weight,out,4),"Cannot prepare bounded profile");
+    const auto ready=MetalContext::N4Stats();
+#ifdef GARNET_METAL_MISTRAL_N4_DECODE
